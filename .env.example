# Base URL of the flood-analysis backend, e.g. https://api.example.org
# Leave empty to run on the bundled demo data in src/data.
VITE_API_BASE_URL=

# Folder of static files written by pipeline/run.py, served from public/, e.g. /data
# When set, the dashboard shows that run instead of the demo data.
VITE_DATA_URL=
